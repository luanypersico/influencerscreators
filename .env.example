SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Origem server-side confiável usada nos convites Auth. Em previews,
# configure com a URL exata *.influencerscreators.pages.dev do deployment.
# Em produção, o fallback seguro é https://influencerscreators.pages.dev.
APP_ORIGIN=""

# Secrets de servidor — NUNCA colocar valor real neste arquivo nem em .env.
# São cadastrados como secrets do ambiente (Lovable Cloud), não via .env:
#   SUPABASE_SERVICE_ROLE_KEY
#   HOTMART_HOTTOK
# Habilite somente ao executar deliberadamente os testes contra o Supabase vivo.
RUN_REAL_SUPABASE_TESTS=false
